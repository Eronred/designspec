{
  "name": "designspec",
  "version": "0.1.0",
  "description": "Keep AI-written UI on your design system: a spec of your tokens and components that coding agents follow and CI enforces.",
  "keywords": [
    "design-system",
    "design-tokens",
    "dtcg",
    "lint",
    "tailwind",
    "shadcn",
    "react",
    "react-native",
    "github-action",
    "mcp",
    "ai-agents"
  ],
  "homepage": "https://github.com/Eronred/designspec#readme",
  "bugs": {
    "url": "https://github.com/Eronred/designspec/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eronred/designspec.git"
  },
  "license": "MIT",
  "author": "Erencan Arica",
  "type": "module",
  "bin": {
    "designspec": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "tsup",
    "schema": "npm run build && node dist/cli.js schema > schema.json",
    "skills": "node scripts/skill-references.mjs",
    "changeset": "changeset"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@babel/parser": "^8.0.10",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.0.0",
    "culori": "^4.0.2",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "postcss": "^8.5.32",
    "postcss-less": "^7.0.1",
    "postcss-scss": "^4.0.9",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/types": "^8.0.10",
    "@changesets/cli": "^3.0.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
