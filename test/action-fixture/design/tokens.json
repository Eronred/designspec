{
  "dimension": {
    "radius-sm": {
      "$type": "dimension",
      "$value": "calc(var(--radius) - 4px)",
      "$extensions": {
        "designspec": {
          "cssVar": "--radius-sm"
        }
      }
    },
    "radius-lg": {
      "$type": "dimension",
      "$value": "var(--radius)",
      "$extensions": {
        "designspec": {
          "cssVar": "--radius-lg"
        }
      }
    },
    "radius": {
      "$type": "dimension",
      "$value": "0.625rem",
      "$extensions": {
        "designspec": {
          "cssVar": "--radius"
        }
      }
    }
  },
  "color": {
    "background": {
      "$type": "color",
      "$value": "oklch(1 0 0)",
      "$extensions": {
        "designspec": {
          "cssVar": "--background",
          "utility": "background",
          "modes": {
            "dark": "oklch(0.145 0 0)"
          }
        }
      }
    },
    "foreground": {
      "$type": "color",
      "$value": "oklch(0.145 0 0)",
      "$extensions": {
        "designspec": {
          "cssVar": "--foreground",
          "utility": "foreground",
          "modes": {
            "dark": "oklch(0.985 0 0)"
          }
        }
      }
    },
    "primary": {
      "$type": "color",
      "$value": "oklch(0.205 0 0)",
      "$extensions": {
        "designspec": {
          "cssVar": "--primary",
          "utility": "primary",
          "modes": {
            "dark": "oklch(0.922 0 0)"
          }
        }
      }
    },
    "primary-foreground": {
      "$type": "color",
      "$value": "oklch(0.985 0 0)",
      "$extensions": {
        "designspec": {
          "cssVar": "--primary-foreground",
          "utility": "primary-foreground",
          "modes": {
            "dark": "oklch(0.205 0 0)"
          }
        }
      }
    },
    "muted-foreground": {
      "$type": "color",
      "$value": "oklch(0.556 0 0)",
      "$extensions": {
        "designspec": {
          "cssVar": "--muted-foreground",
          "utility": "muted-foreground",
          "modes": {
            "dark": "oklch(0.708 0 0)"
          }
        }
      }
    },
    "destructive": {
      "$type": "color",
      "$value": "oklch(0.577 0.245 27.325)",
      "$extensions": {
        "designspec": {
          "cssVar": "--destructive",
          "utility": "destructive",
          "modes": {
            "dark": "oklch(0.704 0.191 22.216)"
          }
        }
      }
    },
    "border": {
      "$type": "color",
      "$value": "oklch(0.922 0 0)",
      "$extensions": {
        "designspec": {
          "cssVar": "--border",
          "utility": "border",
          "modes": {
            "dark": "oklch(1 0 0 / 10%)"
          }
        }
      }
    }
  }
}
